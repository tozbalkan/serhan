// Serhan Turizm — Prisma schema (domain model)
//
// Prisma ORM v7 notes:
//   - The `prisma-client` provider generates a Rust-free ESM client.
//   - The client is generated to `./generated/prisma` (relative to this file),
//     i.e. `prisma/generated/prisma`, and MUST NOT be committed (see .gitignore).
//   - The datasource connection URL lives in prisma.config.ts, not here.
//   - The client is wired to PostgreSQL via the `@prisma/adapter-pg` driver
//     adapter in `lib/db.ts`. Do not revert to an older Prisma architecture.
//
// Domain model:
//   The models below represent the actual Serhan Turizm domain. They are kept
//   simple and direct — no repositories, no service layers, no audit-event or
//   soft-delete infrastructure. Request types (Teklif, IsBasvuru, Iletisim,
//   AracGeriBildirim) are intentionally SEPARATE tables; the future admin
//   "Talepler" view normalizes them at the query layer. No polymorphic Request
//   table, no UNION infrastructure.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared enum
// ---------------------------------------------------------------------------

enum TalepDurumu {
  YENI
  INCELENIYOR
  ILETISIME_GECILDI
  TAMAMLANDI
}

// ---------------------------------------------------------------------------
// Musteri (Customer / Parent)
// ---------------------------------------------------------------------------

model Musteri {
  id        String   @id @default(cuid())
  adSoyad   String
  telefon   String   @unique // primary matching key
  eposta    String?  // secondary matching key
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ogrenciler Ogrenci[]
  onKayitlar OnKayit[]

  @@index([telefon])
  @@index([eposta])
}

// ---------------------------------------------------------------------------
// Ogrenci (Student)
// ---------------------------------------------------------------------------

model Ogrenci {
  id           String   @id @default(cuid())
  musteriId    String
  okulId       String
  ad           String
  soyad        String
  sinifKademe  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  musteri    Musteri    @relation(fields: [musteriId], references: [id])
  okul       Okul       @relation(fields: [okulId], references: [id])
  onKayitlar OnKayit[]

  @@index([musteriId])
  @@index([okulId])
  @@unique([musteriId, ad, soyad, okulId]) // composite unique: same student in same school
}

// ---------------------------------------------------------------------------
// Okul (School)
// ---------------------------------------------------------------------------

model Okul {
  id            String   @id @default(cuid())
  ad            String
  slug          String   @unique // immutable from the application perspective
  aktif         Boolean  @default(true) // false disables the QR form; URL stays valid
  tcKimlikIster Boolean  @default(false)
  createdAt     DateTime @default(now())

  onKayitlar OnKayit[]
  ogrenciler Ogrenci[]

  @@index([aktif])
}

// ---------------------------------------------------------------------------
// OnKayit (School-service pre-registration via QR)
// ---------------------------------------------------------------------------

model OnKayit {
  id                 String       @id @default(cuid())
  okulId             String
  musteriId          String?      // CRM: current customer/parent
  ogrenciId          String?      // CRM: current student identity
  ogrenciAd          String       // historical snapshot
  ogrenciSoyad       String       // historical snapshot
  sinifKademe        String       // historical snapshot
  tcKimlikNo         String?      // required only when Okul.tcKimlikIster; decided at app layer
  adres              String       // historical snapshot
  veliAdSoyad        String       // historical snapshot
  telefon            String       // historical snapshot
  eposta             String?      // historical snapshot
  status             TalepDurumu  @default(YENI)
  notificationSent   Boolean      @default(false)
  notificationSentAt DateTime?
  createdAt          DateTime     @default(now())

  okul      Okul       @relation(fields: [okulId], references: [id])
  musteri   Musteri?   @relation(fields: [musteriId], references: [id])
  ogrenci   Ogrenci?   @relation(fields: [ogrenciId], references: [id])
  consent   Consent?

  @@index([okulId])
  @@index([musteriId])
  @@index([ogrenciId])
  @@index([createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Consent (KVKK consent record, kept independent from operational OnKayit data)
// ---------------------------------------------------------------------------

model Consent {
  id                    String    @id @default(cuid())
  onKayitId             String    @unique // one-to-one with OnKayit
  privacyNoticeVersion  String // which legal version was acknowledged (see lib/legal/config.ts)
  privacyAcknowledgedAt DateTime
  explicitConsent       Boolean
  explicitConsentAt     DateTime?
  marketingConsent      Boolean   @default(false)
  marketingConsentAt    DateTime?
  ipAddress             String

  onKayit OnKayit @relation(fields: [onKayitId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Request types (separate tables — no polymorphic Request model)
// ---------------------------------------------------------------------------

model Teklif {
  id        String      @id @default(cuid())
  adSoyad   String
  telefon   String
  eposta    String
  mesaj     String
  status    TalepDurumu @default(YENI)
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([status])
}

model IsBasvuru {
  id        String      @id @default(cuid())
  adSoyad   String
  telefon   String
  eposta    String
  mesaj     String
  status    TalepDurumu @default(YENI)
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([status])
}

model Iletisim {
  id        String      @id @default(cuid())
  adSoyad   String
  telefon   String
  eposta    String
  mesaj     String
  status    TalepDurumu @default(YENI)
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([status])
}

model AracGeriBildirim {
  id        String      @id @default(cuid())
  adSoyad   String
  telefon   String
  eposta    String
  mesaj     String
  status    TalepDurumu @default(YENI)
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// User (minimal, for future admin authentication — no auth implemented yet)
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
